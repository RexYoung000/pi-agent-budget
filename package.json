{
  "name": "pi-agent-budget",
  "version": "0.1.0",
  "description": "Pi extension: unified cost observability, control, and optimization for AI coding (agent / plan / vibe).",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "clean": "rm -rf node_modules",
    "build": "echo 'pi loads .ts directly via jiti — no build step required'",
    "check": "tsc --noEmit",
    "dev": "pi -e ./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@types/better-sqlite3": "^7.6.11",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "ai",
    "cost",
    "budget",
    "observability"
  ],
  "license": "MIT"
}
